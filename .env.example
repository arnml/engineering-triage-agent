# Required for model-based analysis
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional: when both are set, findings are posted automatically to this ClickUp list.
# With either missing, the finding is printed to the console for manual handling.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# Optional limits
MAX_INVESTIGATION_ROUNDS=2
MAX_REPO_FILES=250
MAX_FILE_BYTES=200000
